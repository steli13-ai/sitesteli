# Vite environment variables for Mate cu succes
# Copy to .env and fill with your project keys

# Public site URL (used for return/cancel URLs if needed)
VITE_SITE_URL=http://localhost:4028

# Supabase client
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Netopia Edge Function / backend endpoint that returns { payment_url }
# Example: https://<project-ref>.supabase.co/functions/v1/netopia-create-payment
VITE_NETOPIA_FUNCTION_URL=

# Development aid: set to true to simulate successful payment redirection
# when the Netopia function URL is missing or failing locally.
VITE_ENABLE_PAYMENT_SIMULATOR=true
